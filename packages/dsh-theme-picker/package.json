{
  "name": "dsh-theme-picker",
  "version": "0.2.0",
  "description": "Install many theme packs, switch between them instantly, no reload",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.bundle.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "ui"
  ],
  "author": "yinqiang (https://github.com/yinqiang)",
  "license": "MIT",
  "homepage": "https://github.com/yinqiang/dsh-plugins/tree/main/packages/dsh-theme-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinqiang/dsh-plugins.git",
    "directory": "packages/dsh-theme-picker"
  },
  "bugs": {
    "url": "https://github.com/yinqiang/dsh-plugins/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    },
    "marketplace": {
      "profiles": [
        "web"
      ],
      "manualSteps": false,
      "requiresRestart": true,
      "requiresBuildApproval": false
    }
  }
}
